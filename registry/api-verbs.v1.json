{
  "kind": "yai.api.operation_verbs",
  "version": "v1",
  "verbs": [
    {
      "id": "status",
      "meaning": "Read current status",
      "mutation_class": "read",
      "expected_idempotency": "idempotent",
      "common_use": "health/posture visibility",
      "incompatible_use_notes": "not for lifecycle control"
    },
    {
      "id": "whoami",
      "meaning": "Read current principal identity",
      "mutation_class": "read",
      "expected_idempotency": "idempotent",
      "common_use": "identity introspection",
      "incompatible_use_notes": "not authentication itself"
    },
    {
      "id": "login",
      "meaning": "Request authenticated context",
      "mutation_class": "control",
      "expected_idempotency": "non-idempotent",
      "common_use": "session admission",
      "incompatible_use_notes": "no provider/backend auth implied"
    },
    {
      "id": "logout",
      "meaning": "End authenticated context",
      "mutation_class": "control",
      "expected_idempotency": "idempotent",
      "common_use": "session termination",
      "incompatible_use_notes": "not service lifecycle"
    },
    {
