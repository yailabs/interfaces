{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yai.runtime-service-status.v1",
  "title": "YAI Runtime Service Status v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "lifecycleState",
    "readiness",
    "health",
    "mode",
    "controlPosture",
    "message"
  ],
  "properties": {
    "schema": {
      "const": "api.runtime.service.status.v1"
    },
    "serviceId": {
      "type": "string"
    },
    "status": {
      "enum": [
        "unknown",
        "unavailable",
        "stopped",
        "starting",
        "running",
        "stopping",
        "degraded",
        "error"
      ]
    },
    "lifecycleState": {
      "enum": [
        "unknown",
        "unavailable",
        "stopped",
        "starting",
        "running",
        "stopping",
        "degraded",
        "error"
      ]
    },
    "readiness": {
      "enum": [
        "ready",
        "pending",
        "unavailable",
        "degraded",
        "error"
      ]
    },
    "health": {
      "enum": [
        "available",
        "pending",
        "unavailable",
        "degraded",
        "error",
        "unknown"
      ]
    },
    "mode": {
      "enum": [
        "local-dev",
        "local-service-planned",
        "remote-service-planned"
      ]
    },
    "controlPosture": {
      "enum": [
        "dev-wrapper",
        "service-manager-planned",
        "unavailable"
      ]
    },
    "message": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "refs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
