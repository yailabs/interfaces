{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yai.request-envelope.v1",
  "allOf": [
    {
      "$ref": "schemas/envelope.v1.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "schema",
    "envelope_id",
    "operation_id",
    "request_id",
    "correlation_id",
    "client",
    "transport",
    "created_at",
    "input"
  ],
  "properties": {
    "schema": {
      "const": "yai.request-envelope.v1"
    },
    "envelope_id": {
      "type": "string"
    },
    "operation_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "client": {
      "$ref": "schemas/client-ref.v1.schema.json"
    },
    "client_subject_ref": {
      "$ref": "schemas/client-subject-ref.v1.schema.json"
    },
    "client_connection_ref": {
      "$ref": "schemas/client-connection-ref.v1.schema.json"
    },
    "client_attachment_ref": {
      "$ref": "schemas/client-attachment-ref.v1.schema.json"
    },
    "system_root_context_ref": {
      "$ref": "schemas/system-root-context-ref.v1.schema.json",
      "default": "root-context://system/default"
    },
    "work_case_ref": {
      "$ref": "schemas/work-case-ref.v1.schema.json"
    },
    "system_call_ref": {
      "$ref": "schemas/system-call-ref.v1.schema.json"
    },
    "case_ref": {
      "$ref": "schemas/case-ref.v1.schema.json"
    },
    "principal_ref": {
      "type": "string"
    },
    "transport": {
      "type": "object",
      "required": [
        "transport_class"
      ],
      "properties": {
        "transport_class": {
          "type": "string",
          "enum": [
            "local_ipc_rpc",
            "local_http_loopback",
            "lan_secure",
            "remote_https",
            "in_process_test",
            "subprocess_stdio_compat"
          ]
        },
        "binding": {
          "type": "string"
        },
        "security_posture": {
          "type": "string"
        },
        "paired": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "input": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    },
    "idempotency_key": {
      "type": "string"
    },
    "stream_request": {
      "type": "object",
      "required": [
        "stream"
      ],
      "properties": {
        "stream": {
          "const": true
        },
        "resume_token": {
          "type": "string"
        },
        "heartbeat_interval_ms": {
          "type": "integer",
          "minimum": 0
        },
        "accept_event_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "stream.open",
              "stream.heartbeat",
              "stream.data",
              "stream.warning",
              "stream.error",
              "stream.cancelled",
              "stream.closed"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1
    },
    "cancellation_ref": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
