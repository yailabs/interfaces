{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yai.error.v1",
  "type": "object",
  "required": [
    "code",
    "message"
  ],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "validation_error",
        "unauthorized",
        "forbidden",
        "not_found",
        "conflict",
        "unsupported_operation",
        "not_implemented",
        "precondition_failed",
        "governance_required",
        "control_gate_required",
        "runtime_unavailable",
        "provider_unavailable",
        "internal_error"
      ]
    },
    "message": {
      "type": "string"
    },
    "details": {
      "type": "object"
    },
    "retryable": {
      "type": "boolean"
    }
  }
}
