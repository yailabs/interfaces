{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yai.watch-event.v1",
  "type": "object",
  "required": [
    "event_id",
    "operation_id",
    "stream_id",
    "sequence",
    "timestamp",
    "event_type",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "operation_id": {
      "type": "string"
    },
    "stream_id": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "case_ref": {
      "$ref": "schemas/case-ref.v1.schema.json"
    },
    "workflow_ref": {
      "$ref": "schemas/workflow-ref.v1.schema.json"
    },
    "record_refs": {
      "type": "array",
      "items": {
        "$ref": "schemas/record-ref.v1.schema.json"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "schemas/evidence-ref.v1.schema.json"
      }
    },
    "payload": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  }
}
