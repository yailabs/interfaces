{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yai.client-connection-ref.v1",
  "title": "YAI Client Connection Ref v1",
  "x-yai-projection": {
    "projection_role": "api_schema_mirror",
    "source_of_truth": "../yai/protocols/refs/client-connection-ref.v1.schema.json"
  },
  "description": "Ephemeral lifecycle identity for one concrete client connection. Not a stable client subject, case, or session.",
  "type": "string",
  "pattern": "^client-connection://[A-Za-z0-9][A-Za-z0-9._~-]*(?:/[A-Za-z0-9][A-Za-z0-9._~:-]*)+$",
  "examples": [
    "client-connection://local-ipc-rpc/a4-console-0001",
    "client-connection://local-http-loopback/a4-sdk-0001",
    "client-connection://console/a4-console-0002"
  ]
}
