{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yai.system-call-ref.v1",
  "title": "YAI System Call Ref v1",
  "x-yai-projection": {
    "projection_role": "api_schema_mirror",
    "source_of_truth": "../yai/protocols/refs/system-call-ref.v1.schema.json"
  },
  "description": "Stable ref for one technical client-to-runtime or client-to-API call event. Not an operation result, work case action, evidence record, or provider call record.",
  "type": "string",
  "pattern": "^system-call://[A-Za-z0-9][A-Za-z0-9._~:-]*(?:/[A-Za-z0-9][A-Za-z0-9._~:-]*)*$",
  "examples": [
    "system-call://a4-status-0001",
    "system-call://2026-05-09T00:00:00Z/a4-status-0001"
  ]
}
