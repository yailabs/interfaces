{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yai.local-event-stream.event_frame.v1",
  "title": "YAI Local Event Stream Event Frame v1",
  "type": "object",
  "required": [
    "schema",
    "stream_id",
    "event_id",
    "operation_id",
    "request_id",
    "sequence",
    "event_type",
    "created_at",
    "terminal",
    "heartbeat"
  ],
  "properties": {
    "schema": {
      "const": "yai.local-event-stream.event_frame.v1"
    },
    "stream_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "operation_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "client": {
      "$ref": "../../schemas/client-ref.v1.schema.json"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "event_type": {
      "type": "string",
      "enum": [
        "stream.open",
        "stream.heartbeat",
        "stream.data",
        "stream.warning",
        "stream.error",
        "stream.cancelled",
        "stream.closed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object"
    },
    "error": {
      "$ref": "../../schemas/error.v1.schema.json"
    },
    "terminal": {
      "type": "boolean"
    },
    "heartbeat": {
      "type": "boolean"
    },
    "retry_after_ms": {
      "type": "integer",
      "minimum": 0
    },
    "resume_token": {
      "type": "string"
    },
    "redaction": {
      "type": "object",
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
